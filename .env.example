# Credentials and secrets for Static PHP Contact form.
# Copy to ".env" at the project root and fill in. Never commit it: .env is
# git-ignored, and .htaccess denies it over HTTP — verify with
#   curl -I https://your-domain.com/backend/.env    → must return 403.
#
# Syntax: KEY=value, one per line. A "#" after whitespace starts a comment, so
# quote any value containing one:  SMTP_PASS="pa ss#word"

# --- outgoing mail (SMTP) -----------------------------------------------
SMTP_HOST=mail.example.com
SMTP_PORT=587
SMTP_USER=contact@example.com
SMTP_PASS=CHANGE-ME

# Where the messages land. Comma-separate for several recipients.
MAIL_TO=contact@example.com

# --- who may post to these endpoints ------------------------------------
# Comma-separated hosts. Every site displaying a form must be listed, even if
# it is on the same domain as this backend. Keep localhost for local testing.
ORIGINS=localhost,example.com,www.example.com

# --- shared secrets ------------------------------------------------------
# Any random strings. USER_SECRET links user-agent.php to send-email.php;
# ADMIN_SECRET authorises update-geoip.php (so bots cannot trigger downloads).
USER_SECRET=CHANGE-ME-RANDOM
ADMIN_SECRET=CHANGE-ME-RANDOM

# --- MaxMind GeoIP2 Lite (free) ------------------------------------------
# https://support.maxmind.com/hc/en-us/articles/4407111582235-Generate-a-License-Key
MAXMIND_ACCOUNT=123456
MAXMIND_KEY=CHANGE-ME
